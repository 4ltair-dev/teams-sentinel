# ==========================================
# Teams Sentinel Configuration Example
# ==========================================

# 1. Telegram Bot Token (получить у @BotFather)
TELEGRAM_BOT_TOKEN=1234567890:ABCDefghIJKlmnoPQRstuvWXyz

# 2. Твой Telegram User ID (получить у @userinfobot или @GetMyID_Bot)
TELEGRAM_USER_ID=123456789

# 3. Google Gemini API Key (получить в Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSy...

# Модель Gemini (gemini-2.5-flash, gemini-2.5-pro, gemini-2.0-flash и т.д.)
GEMINI_MODEL=gemini-2.5-flash

# 4. Аудиоустройство для захвата звука преподавателя
# AUDIO_DEVICE_INDEX - индекс устройства из `python device_detector.py`
# Либо оставь пустым: в Linux Sentinel автоматически слушает текущий вывод наушников/колонок
AUDIO_DEVICE_INDEX=
# Опционально: точное имя PulseAudio/PipeWire монитора (если хочешь зафиксировать конкретное устройство)
# AUDIO_MONITOR_SOURCE=alsa_output.pci-0000_00_1f.3.analog-stereo.monitor

# 5. Длительность записи вопроса преподавателя после сработки триггера (в секундах, по умолчанию 7)
RECORD_CONTEXT_SECONDS=7

# 6. Список триггерных слов (через запятую, регистр не важен)
TRIGGER_WORDS=иван, иванов, иванова

# 7. Путь к локальной модели Vosk (по умолчанию папка model в корне проекта)
VOSK_MODEL_PATH=model

# 8. Задержка (cooldown) после тревоги, чтобы не спамить повторно (в секундах)
COOLDOWN_SECONDS=20

# 9. Авто-плюс в Teams (когда 3-4 человека пишут «+» в чате)
AUTO_PLUS_ENABLED=true
AUTO_PLUS_THRESHOLD=3
AUTO_PLUS_WINDOW_SECONDS=25
BRIDGE_PORT=8765

# 10. Авто-приветствие в Teams (когда 3-4 человека пишут «Здравствуйте» в чате)
AUTO_GREETING_ENABLED=true
AUTO_GREETING_THRESHOLD=3
